# ─────────────────────────────────────────────
#  Sistem Manajemen Penggilingan Beras — Konfigurasi
#  Salin file ini menjadi `.env` lalu isi nilainya.
# ─────────────────────────────────────────────

# ── Database (cocok dengan docker-compose.yml) ──
DATABASE_URL=postgresql+asyncpg://milluser:millpass@localhost:5432/penggilingan

# ── Telegram Bot Tokens (dari @BotFather) ──
# Isi setelah Anda membuat 3 bot terpisah.
BOT_GUDANG1_TOKEN=
BOT_GUDANG2_TOKEN=
BOT_ADMIN_TOKEN=

# ── Claude AI ──
ANTHROPIC_API_KEY=
# Model NLP. Haiku = hemat & cepat. Ganti ke claude-opus-4-8 untuk akurasi maksimal.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Admin awal (auto-seed ke DB kosong saat startup) ──
# Telegram user id admin pertama (dapatkan dari @userinfobot). Kosongkan bila
# tidak ingin auto-buat user. Untuk staging boleh pakai id yang sama.
ADMIN_TELEGRAM_ID=
ADMIN_NAME=Ahmad Wahid Nurhani

# ── Aplikasi ──
# Zona waktu untuk timestamp & kode batch (GB-YYYYMMDD-NN).
APP_TIMEZONE=Asia/Jakarta
# Menit jendela pembatalan input (dokumen: 15 menit).
UNDO_WINDOW_MINUTES=15
# Maksimal batch pembelian gabah per hari (dokumen: 3).
MAX_PURCHASE_BATCH_PER_DAY=3
