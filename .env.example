# ─────────────────────────────────────────────
#  Sistem Manajemen Penggilingan Beras — Konfigurasi
#  Salin file ini menjadi `.env` lalu isi nilainya.
# ─────────────────────────────────────────────

# ── Database (cocok dengan docker-compose.yml) ──
DATABASE_URL=postgresql+asyncpg://milluser:millpass@localhost:5432/penggilingan

# ── Telegram Bot Tokens (dari @BotFather) ──
# Isi setelah Anda membuat 3 bot terpisah.
BOT_GUDANG1_TOKEN=
BOT_GUDANG2_TOKEN=
BOT_ADMIN_TOKEN=

# ── Claude AI ──
ANTHROPIC_API_KEY=
# Model NLP. Haiku = hemat & cepat. Ganti ke claude-opus-4-8 untuk akurasi maksimal.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Admin awal (auto-seed ke DB kosong saat startup) ──
# Telegram user id admin pertama (dapatkan dari @userinfobot). Kosongkan bila
# tidak ingin auto-buat user. Untuk staging boleh pakai id yang sama.
ADMIN_TELEGRAM_ID=
ADMIN_NAME=Ahmad Wahid Nurhani

# ── Aplikasi ──
# Zona waktu untuk timestamp & kode batch (GB-YYYYMMDD-NN).
APP_TIMEZONE=Asia/Jakarta
# Menit jendela pembatalan input (dokumen: 15 menit).
UNDO_WINDOW_MINUTES=15
# Maksimal batch pembelian gabah per hari (dokumen: 3).
MAX_PURCHASE_BATCH_PER_DAY=3
# Token rahasia untuk buka Dashboard Produksi web (/dashboard?token=...).
# Kosongkan untuk menonaktifkan dashboard web (perintah Telegram tetap jalan).
DASHBOARD_TOKEN=

# ── Seam Kantor ↔ Produksi (pemisahan repo/service, satu DB) ──
# Sisi PRODUKSI: mengaktifkan /internal/produksi/* (kosong = endpoint 404).
INTERNAL_API_TOKEN=
# Sisi KANTOR (selama modul kantor masih ikut proses ini, WAJIB diisi — kalau
# tidak, tool tanya_produksi/simulasi HPP & bagian operasional briefing mati).
# Isi dengan URL PUBLIK service ini sendiri + token yang sama seperti di atas.
PRODUKSI_API_URL=
PRODUKSI_API_TOKEN=
PRODUKSI_API_TIMEOUT=120

# ── Webapp produksi (Fase B) ──
# Kunci penanda-tangan cookie sesi. WAJIB diisi: bila kosong, kuncinya acak per
# proses dan semua sesi login hangus setiap kali server restart.
SECRET_KEY=
# Umur sesi perangkat PRIBADI (admin & staff) dan perangkat GUDANG (operator).
SESI_HARI=30
SESI_BERSAMA_MENIT=45
# Akun webapp PERTAMA. Isi sekali saat menyiapkan sistem: bila belum ada akun
# sama sekali, dibuatkan akun untuk user ber-ADMIN_TELEGRAM_ID dengan sandi ini
# (wajib diganti saat pertama masuk). KOSONGKAN lagi setelah akunnya jadi.
ADMIN_USERNAME=admin
ADMIN_SANDI_AWAL=
